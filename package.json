{
  "name": "nextgen-qa-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs",
    "preview": "pnpm dlx serve out -l 3005",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/check-size.mjs",
    "perf": "node scripts/lighthouse.mjs",
    "check": "pnpm build && pnpm size && node scripts/lighthouse.mjs --runs=3"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.6.5"
}
