# Contact form (EmailJS, https://www.emailjs.com — free plan: 200 emails/month).
# Copy to .env.local for local dev and add the same three variables in the hosting dashboard.
# All three are public identifiers (they ship in the browser bundle); without them the form
# falls back to the pre-filled mailto: link.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Sub-folder hosting (e.g. GitHub Pages): leave empty for the root.
NEXT_PUBLIC_BASE_PATH=
